# Isharati (إشارتي) — environment variables
#
# Copy this file to `.env` at the project root and fill in the keys you have:
#     cp .env.example .env        (Windows: copy .env.example .env)
# The app reads `.env` at start-up (src/isharati/config.py); variables already set in the shell win.
# Never commit `.env`: it is in .gitignore. On a Hugging Face Space, set the same names in
# Settings -> Variables and secrets (keys as *secrets*), not in a file.
#
# Minimum to run the app locally: HF_TOKEN + one language-model key (OPENROUTER_API_KEY, or NVIDIA_API_KEY / GROQ_API_KEY).


# ─── Language models (the answer and the sign glosses) ─────────────────────────────────────────────────────────────

# OpenRouter: one key for many models; what the live demo uses (paid qwen/qwen3.8-27b, then qwen/qwen3.8-flash).
#   Get it: https://openrouter.ai/keys  (sign in -> Create key; add credit at https://openrouter.ai/credits,
#   and set a credit limit on the key). Free models (names ending in ":free") work without credit, but are slower.
OPENROUTER_API_KEY=

# Which provider the app calls: "openrouter" uses the key above; leave empty to use NVIDIA NIM, then Groq.
ISHARATI_LLM=openrouter

# Optional: the OpenRouter models to try in order, comma-separated (default in src/isharati/llm.py, OPENROUTER_MODELS).
# ISHARATI_MODELS=qwen/qwen3.8-27b,qwen/qwen3.8-flash

# NVIDIA NIM (build.nvidia.com): free starter credits; used when ISHARATI_LLM is not "openrouter".
#   Get it: https://build.nvidia.com -> sign in -> open any model (e.g. Nemotron) -> "Get API Key" (starts with nvapi-).
NVIDIA_API_KEY=

# Groq: fast free tier. Used for (1) speech-to-text, Whisper large-v3, in the "audio / video" mode (khutbah, lesson),
# and (2) the last fallback language model.
#   Get it: https://console.groq.com/keys -> Create API Key (starts with gsk_).
GROQ_API_KEY=


# ─── Hugging Face (the data, and the question embeddings) ──────────────────────────────────────────────────────────

# Hugging Face access token. Needed to download the datasets the app reads and, with ISHARATI_EMBED=hf, to embed
# questions with hosted inference (multilingual-E5).
#   Get it: https://huggingface.co/settings/tokens -> Create new token -> type "Read" (enough to run the app).
#   The datasets below are private (several sign sources do not allow redistribution): ask the authors for access,
#   then your own read token works.
HF_TOKEN=

# "hf": question embeddings from Hugging Face inference (no GPU needed). Empty: a local embedding service
# (python scripts/corpora/embeddings.py serve).
ISHARATI_EMBED=hf

# The datasets (owner/name). Defaults are the authors' datasets on the Hub.
ISHARATI_HUB_DATASET=FatimahEmadEldin/isharati-data          # corpora + sign lexicons, one folder per language
# ISHARATI_APP_DATASET=FatimahEmadEldin/isharati-app-data     # Academy alphabet, Qur'an text, precomputed answers
# ISHARATI_QURAN_OWNER=FatimahEmadEldin                       # owner of the signed Qur'an datasets (quran-sign-*)
# ISHARATI_HADITH_OWNER=FatimahEmadEldin                      # owner of hadith-sign


# ─── Optional: Review Studio database ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for the sign-review dashboard (/review). Not needed for asking questions.
#   Get it: https://console.neon.tech -> create a project -> Dashboard -> "Connection string" (postgresql://...).
#   Any PostgreSQL works. Keep it secret: it contains the password.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require


# ─── Optional: local paths and options ─────────────────────────────────────────────────────────────────────────────

# ISHARATI_DATA_DIR=./data                 # where the datasets are restored (default: data/ in the project)
# ISHARATI_OUT_DIR=./data/asl/out          # one folder per answered question (the answer cache)
# ISHARATI_APP_DATA_DIR=                   # a local copy of isharati-app-data instead of the Hub
# ISHARATI_LANGS=en,ar,tr,ur               # languages the server loads
# ISHARATI_URDU_WSLP=1                     # Urdu: also the WSLP lexicon (CC BY-NC-ND 4.0, non-commercial); 0 to leave out
# ISHARATI_URDU_ISLRTC=1                   # Urdu: also the ISLRTC dictionary and manual alphabet; 0 to leave out
# ISHARATI_HOLISTIC_MODEL=                 # MediaPipe holistic_landmarker.task for pose extraction (downloaded if empty)
# HOST=127.0.0.1                           # web server address
# PORT=8765                                # web server port (the Space uses 7860)
